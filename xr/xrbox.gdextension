[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
macos.debug.arm64 = "res://native/macos-arm64/debug/libxrbox_godot.dylib"
macos.release.arm64 = "res://native/macos-arm64/release/libxrbox_godot.dylib"
linux.debug.arm64 = "res://native/linux-arm64/debug/libxrbox_godot.so"
linux.release.arm64 = "res://native/linux-arm64/release/libxrbox_godot.so"
linux.debug.x86_64 = "res://native/linux-x86_64/debug/libxrbox_godot.so"
linux.release.x86_64 = "res://native/linux-x86_64/release/libxrbox_godot.so"
android.debug.arm64 = "res://native/android-arm64/debug/libxrbox_godot.so"
android.release.arm64 = "res://native/android-arm64/release/libxrbox_godot.so"
